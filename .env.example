# Example environment file. Copy to `.env` and fill in your own values,
# or place the equivalent files under `secrets/` (see docs/ABOUT.md).
# Never commit real credentials: `.env` and `secrets/` are gitignored.

# Official work-study API token
LBA_TOKEN=your-api-token

# Telegram bot
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Google Sheets service account (path to the JSON key file)
GOOGLE_SERVICE_ACCOUNT=secrets/google_service_account.json

# Target Google Sheet id (found in the sheet URL between /d/ and /edit)
SPREADSHEET_ID=your-sheet-id
