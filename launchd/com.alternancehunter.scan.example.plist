<?xml version="1.0" encoding="UTF-8"?>
<!-- Exemple de planification macOS : scan plusieurs fois par jour.
     Copier dans ~/Library/LaunchAgents/ en adaptant les chemins,
     puis : launchctl load -w ~/Library/LaunchAgents/<ce fichier>.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alternancehunter.scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>run_once.py</string>
    <string>alternance</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOU/alternance-hunter</string>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/YOU/alternance-hunter/logs/scan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/alternance-hunter/logs/scan.err.log</string>
</dict>
</plist>
