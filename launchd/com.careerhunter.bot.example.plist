<?xml version="1.0" encoding="UTF-8"?>
<!-- Example: keep the Telegram bot alive (answers buttons continuously).
     Copy into ~/Library/LaunchAgents/ with your own paths. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.careerhunter.bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>telegram_bot.py</string>
    <string>alternance</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOU/career-hunter</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOU/career-hunter/logs/bot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/career-hunter/logs/bot.err.log</string>
</dict>
</plist>
